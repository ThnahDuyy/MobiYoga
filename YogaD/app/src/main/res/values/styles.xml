<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="btn_edit_item">
        <item name="android:layout_gravity">center</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:padding">@dimen/_9sdp</item>
        <item name="android:layout_width">@dimen/_40sdp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
    </style>

    <style name="txt_view_yoga_class_detail">
        <item name="android:textSize">@dimen/_17sdp</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="icon_view_yoga_class_detail">
        <item name="android:layout_gravity">center</item>
        <item name="android:layout_width">35dp</item>
        <item name="android:layout_height">35dp</item>
    </style>

    <style name="icon_view_yoga_class">
        <item name="android:layout_gravity">center</item>
        <item name="android:layout_width">@dimen/_20sdp</item>
        <item name="android:layout_height">@dimen/_20sdp</item>
    </style>

    <style name="icon_btn">
        <item name="android:layout_gravity">center</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:padding">10dp</item>
        <item name="android:layout_height">@dimen/_35sdp</item>
        <item name="android:layout_width">@dimen/_35sdp</item>
    </style>

</resources>