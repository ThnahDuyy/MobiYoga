<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:yoga_d_client.app.page.yoga_class_page"
             xmlns:model="clr-namespace:yoga_d_client.app.model"
             x:DataType="views:YogaClassViewModel"
             x:Class="yoga_d_client.app.page.yoga_class_page.YogaClassPage">
    <Grid Padding="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <HorizontalStackLayout Grid.Row="0">
            <Label FontSize="30" Text="Yoga Class" FontAttributes="Bold"/>

            <ImageButton 
                Source="undo.png" 
                 WidthRequest="50" 
                HeightRequest="30" 
                Margin="150,0,0,0"
                Command="{Binding OnRefreshingCommand}"/>

            <ImageButton 
                Source="filter.png" 
                 WidthRequest="50" 
                HeightRequest="30" 
                Margin="20,0,0,0"
                Clicked="Searching"/>
        </HorizontalStackLayout>
        <ActivityIndicator 
            IsRunning="{Binding IsLoading}"
            Grid.Row="1" 
            HorizontalOptions="Center"
            VerticalOptions="Center"/>
        <CollectionView 
                Grid.Row="1" 
            ItemsSource="{Binding YogaClasseList}" 
                Margin="0,20,0,0">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="model:YogaClass">
                    <Frame Padding="10" Margin="5" BorderColor="LightGray" BackgroundColor="{StaticResource Primary}">
                        <VerticalStackLayout Spacing="15">
                            <Label 
                                Text="{Binding yogaName, StringFormat='Name: {0}'}"   
                                TextColor="White"
                                FontSize="Medium" />
                            <Label 
                                Text="{Binding timeOfCourse, StringFormat='Time of couse: {0}'}"   
                                TextColor="White"
                                FontSize="Medium" />
                            <Label 
                                Text="{Binding DayOfWeekString, StringFormat='Day of week: {0}'}"   
                                TextColor="White"
                                FontSize="Medium" />
  
                        </VerticalStackLayout>
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer 
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type views:YogaClassViewModel}}, Path=OnClickedYogaClassCommand}"
                                    CommandParameter="{Binding }"
                                    />
                        </Frame.GestureRecognizers>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
